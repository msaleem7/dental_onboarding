<div class="repeater-entry" data-repeater-target="item">
  <% if f.object.persisted? && f.object.source_cv? %>
    <span class="badge badge--cv">From CV<%= " — needs review" if f.object.needs_review? %></span>
  <% end %>

  <div class="form-row">
    <div class="field field--required">
      <%= f.label :job_title %> <%= required_marker %>
      <%= f.text_field :job_title %>
    </div>
    <div class="field field--required">
      <%= f.label :company_name %> <%= required_marker %>
      <%= f.text_field :company_name %>
    </div>
  </div>

  <div class="field">
    <%= f.label :responsibilities %>
    <%= f.text_area :responsibilities, rows: 3 %>
  </div>

  <div class="form-row">
    <div class="field">
      <%= f.label :start_date %>
      <%= f.date_field :start_date %>
    </div>
    <div class="field">
      <%= f.label :end_date %>
      <%= f.date_field :end_date %>
    </div>
  </div>

  <div class="field checkbox-item">
    <%= f.check_box :current_job %>
    <%= f.label :current_job, "I currently work here" %>
  </div>

  <%= f.hidden_field :_destroy %>
  <button type="button" class="btn btn--secondary repeater-entry__remove" data-action="repeater#remove">Remove</button>
</div>
